# ===== Volcengine 豆包语音大模型 (录音文件识别) =====
# 控制台: https://console.volcengine.com/speech/app
VOLC_ASR_APP_ID=your_asr_app_id
VOLC_ASR_ACCESS_TOKEN=your_asr_access_token
VOLC_ASR_CLUSTER=volcengine_input_common

# ===== Volcengine 方舟 / 豆包大模型 (Ark Chat Completion) =====
# 控制台: https://console.volcengine.com/ark
ARK_API_KEY=your_ark_api_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 在方舟创建推理接入点后填入 endpoint id（形如 ep-xxxxx）或公共模型名（如 doubao-pro-32k）
ARK_MODEL=doubao-pro-32k

# ===== 应用配置 =====
# Volcengine 拉取音频的公网地址。本地开发用 ngrok/cpolar 等隧道把 8000 映射出去后填这里。
# 生产建议改成对象存储（TOS/OSS）的公网 URL。
PUBLIC_FILE_BASE_URL=http://localhost:8000/files

# 上限 (MB)
MAX_UPLOAD_MB=2048
