# 豆包API配置
# 在火山引擎控制台获取: https://console.volcengine.com/ark

# API Key - 从火山引擎控制台获取
DOUBAO_API_KEY=your-api-key-here

# 模型端点ID - 在火山引擎创建推理接入点后获取
# 推荐使用视觉模型: doubao-1.5-vision-pro 或 doubao-vision-pro-32k
DOUBAO_MODEL_ENDPOINT=your-endpoint-id-here

# API基础URL (通常不需要修改)
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=false
